# Environment Variables Example
# Copy this file to .env.local and fill in values if needed

# GitHub Pages Build Mode
# Set to "1" when building for GitHub Pages static export
GH_PAGES=1

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Contact Form (optional)
# If implementing a backend contact form:
# CONTACT_FORM_ENDPOINT=https://your-api.com/contact
# CONTACT_FORM_API_KEY=your-api-key